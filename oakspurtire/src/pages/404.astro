---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | Oakspur Tire & Wheel"
  description="That page isn't here."
  callBand={false}
>
  <section class="wrap page-head" style="border-bottom:0">
    <h1>That page rolled away</h1>
    <p class="lede">The address may have changed. The home page has everything.</p>
    <p style="margin-top:1.5rem">
      <a class="btn btn--call" href="/">Go to the home page</a>
    </p>
  </section>
</Base>
