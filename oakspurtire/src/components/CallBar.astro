---
// Stays at the bottom of the screen on phones.
import { site } from '../site';
---

<div class="call-bar">
  <a class="call-bar__call" href={site.phoneHref}>Call {site.phone}</a>
  <a class="call-bar__quote" href="/contact">Get a price</a>
</div>

<style>
  .call-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 20;
    display: none;
    grid-template-columns: 3fr 2fr;
    box-shadow: 0 -2px 0 var(--rubber);
  }

  .call-bar a {
    padding: 1.05rem 0.75rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  .call-bar__call {
    background: var(--oak);
    color: #fff;
  }

  .call-bar__quote {
    background: var(--crayon);
    color: var(--rubber);
  }

  @media (max-width: 47.99rem) {
    .call-bar {
      display: grid;
    }
  }
</style>
