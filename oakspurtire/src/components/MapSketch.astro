---
// A drawn map. The address is made up, so there's no real map to show.
import { site } from '../site';
---

<figure class="map">
  <svg viewBox="0 0 600 380" role="img" aria-label={`Sketch map showing the shop on ${site.address.street}`}>
    <rect width="600" height="380" fill="#d5d9d5"></rect>
    <!-- blocks -->
    <g fill="#e8ebe8">
      <rect x="20" y="20" width="150" height="95"></rect>
      <rect x="190" y="20" width="170" height="95"></rect>
      <rect x="380" y="20" width="200" height="95"></rect>
      <rect x="20" y="145" width="150" height="100"></rect>
      <rect x="190" y="145" width="170" height="100"></rect>
      <rect x="380" y="145" width="200" height="100"></rect>
      <rect x="20" y="275" width="150" height="85"></rect>
      <rect x="190" y="275" width="170" height="85"></rect>
      <rect x="380" y="275" width="200" height="85"></rect>
    </g>
    <!-- the main road -->
    <rect x="0" y="115" width="600" height="30" fill="#f6f7f5"></rect>
    <line x1="0" y1="130" x2="600" y2="130" stroke="#f5c518" stroke-width="2.5" stroke-dasharray="16 12"
    ></line>
    <text x="34" y="107" class="map__street">Thornlatch Ave</text>
    <text x="368" y="300" class="map__street" transform="rotate(-90 368 300)">Brindle St</text>
    <!-- the shop -->
    <rect x="206" y="158" width="92" height="52" fill="#17442f"></rect>
    <circle cx="252" cy="184" r="13" fill="#f5c518"></circle>
    <circle cx="252" cy="184" r="5" fill="#17442f"></circle>
    <text x="310" y="180" class="map__shop">Oakspur</text>
    <text x="310" y="199" class="map__note">Pull in off Thornlatch</text>
  </svg>
</figure>

<style>
  .map {
    margin: 0;
    border: 2px solid var(--rubber);
  }

  .map svg {
    width: 100%;
    height: auto;
  }

  .map__street {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    fill: #4a524f;
  }

  .map__shop {
    font-family: var(--sans);
    font-variation-settings: 'wdth' 125;
    font-size: 17px;
    font-weight: 800;
    fill: #1b1e1d;
  }

  .map__note {
    font-family: var(--sans);
    font-size: 12px;
    fill: #4a524f;
  }
</style>
