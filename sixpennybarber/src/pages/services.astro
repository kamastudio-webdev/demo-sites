---
import Base from '../layouts/Base.astro';
import MenuBoard from '../components/MenuBoard.astro';
import { site } from '../site';
---

<Base
  title="Services and Prices | Sixpenny Barber Shop, Denver"
  description="Haircuts, skin fades, beard trims, hot towel shaves, kids' and senior cuts at Sixpenny Barber Shop in Capitol Hill, Denver."
>
  <section class="wrap page-head">
    <h1>Services and prices</h1>
    <p class="lede">
      Prices include the hot towel, the neck shave and a look in the hand mirror before you go.
      Tips are welcome but never expected.
    </p>
  </section>

  <section class="band" style="padding-top:0">
    <div class="wrap">
      <MenuBoard />
    </div>
  </section>

  <div class="tiles" aria-hidden="true"></div>

  <section class="band band--white">
    <div class="wrap split">
      <div>
        <h2>The hot towel shave</h2>
        <p class="lede" style="margin-top:1rem">
          The thing people come back for. It takes about 45 minutes, and most people nearly fall
          asleep.
        </p>
        <a class="btn btn--primary" href={site.cta.href}>Book a shave</a>
      </div>
      <ol class="shave">
        <li>
          <h3>Hot towel</h3>
          <p>Softens the beard and opens up the skin.</p>
        </li>
        <li>
          <h3>Pre-shave oil and warm lather</h3>
          <p>Brushed in by hand so the razor glides.</p>
        </li>
        <li>
          <h3>Two passes with a straight razor</h3>
          <p>With the grain, then across it, with a second hot towel in between.</p>
        </li>
        <li>
          <h3>Cold towel and balm</h3>
          <p>Closes everything back up. No sting, no bumps.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="wrap split">
      <div>
        <h3 class="q">Do you take walk-ins?</h3>
        <p>
          Yes, whenever a chair is free. Saturday mornings fill up early, so book ahead if you
          can.
        </p>
        <h3 class="q">How do I pay?</h3>
        <p>Cash or any card, at the chair. You can add a tip on the card reader.</p>
      </div>
      <div>
        <h3 class="q">What if I'm running late?</h3>
        <p>
          Call or text. Up to 10 minutes late, we'll still do the full service. After that, we may
          need to shorten it or move you.
        </p>
        <h3 class="q">Do you cut women's hair?</h3>
        <p>We cut short hair of any kind. If you want clippers or scissors on a short cut, book a haircut.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .shave {
    margin: 0;
    padding: 0;
    counter-reset: step;
  }

  .shave li {
    position: relative;
    padding: 1.1rem 0 1.1rem 3.5rem;
    border-top: 1px solid var(--line);
    counter-increment: step;
  }

  .shave li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .shave li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 1rem;
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    border: 1.5px solid var(--oxblood);
    color: var(--oxblood);
    font-family: var(--serif);
    font-weight: 700;
  }

  .shave h3 {
    margin-bottom: 0.25rem;
    font-size: 1.3rem;
  }

  .shave p {
    margin: 0;
  }

  .q {
    margin: 1.5rem 0 0.5rem;
  }

  .q:first-child {
    margin-top: 0;
  }
</style>
