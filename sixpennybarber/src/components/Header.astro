---
import Logo from './Logo.astro';
import { site } from '../site';

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-head">
  <div class="wrap site-head__row">
    <a class="site-head__phone" href={site.phoneHref}>{site.phone}</a>
    <a class="site-head__logo" href="/" aria-label={`${site.name}, home`}>
      <Logo />
    </a>
    <div class="site-head__end">
      <a class="btn btn--primary site-head__book" href={site.cta.href}>{site.cta.label}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    </div>
  </div>

  <nav id="site-nav" class="site-nav" aria-label="Main">
    <ul>
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={here === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
</script>

<style>
  /* A centered sign: phone on the left, logo in the middle, booking on the right,
     and the menu on its own line underneath. */
  .site-head {
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .site-head__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 1rem 0.75rem;
  }

  .site-head__phone {
    justify-self: start;
    color: var(--ink);
    font-weight: 500;
    font-size: 1.05rem;
    text-decoration: none;
  }

  .site-head__logo {
    text-decoration: none;
  }

  .site-head__end {
    justify-self: end;
  }

  .site-nav ul {
    display: flex;
    justify-content: center;
    gap: 2.25rem;
    padding-bottom: 0.4rem;
  }

  .site-nav a {
    display: block;
    padding: 0.4rem 0;
    color: var(--ink);
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .site-nav a:hover {
    border-bottom-color: var(--mint-deep);
  }

  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--oxblood);
    color: var(--oxblood);
  }

  .menu-btn {
    display: none;
    padding: 0.55rem 1rem;
    border: 1.5px solid var(--ink);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  @media (max-width: 47.99rem) {
    .site-head__row {
      grid-template-columns: 1fr auto;
      padding-block: 0.9rem;
    }

    .site-head__phone,
    .site-head__book {
      display: none;
    }

    .menu-btn {
      display: block;
    }

    .site-nav {
      display: none;
    }

    .site-nav.is-open {
      display: block;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0;
    }

    .site-nav li {
      border-top: 1px solid var(--line);
    }

    .site-nav a {
      padding: 0.85rem 1.25rem;
      border: 0;
    }
  }
</style>
