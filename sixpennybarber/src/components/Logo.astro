---
// The mark is an old sixpence coin with a milled edge and "6d" on its face.
import { site } from '../site';

interface Props {
  tone?: 'dark' | 'light';
  size?: 'small' | 'large';
}
const { tone = 'dark', size = 'small' } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`, `logo--${size}`]}>
  <svg class="logo__coin" viewBox="0 0 48 48" aria-hidden="true">
    <circle cx="24" cy="24" r="22.5" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="1.6 1.6"
    ></circle>
    <circle cx="24" cy="24" r="18.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
    <text x="24" y="30.5" text-anchor="middle" class="logo__6d">6d</text>
  </svg>
  <span class="logo__words">
    <span class="logo__name">{site.short}</span>
    <span class="logo__kind">{site.kind}</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    line-height: 1;
    color: var(--ink);
  }

  .logo__coin {
    flex: none;
    width: 46px;
    height: 46px;
    color: var(--oxblood);
  }

  .logo__6d {
    font-family: var(--serif);
    font-weight: 800;
    font-size: 17px;
    fill: currentColor;
  }

  .logo__words {
    display: grid;
    gap: 0.25rem;
  }

  .logo__name {
    font-family: var(--serif);
    font-weight: 800;
    font-size: 1.65rem;
    letter-spacing: -0.01em;
  }

  .logo__kind {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .logo--large {
    flex-direction: column;
    gap: 0.6rem;
    text-align: center;
  }

  .logo--large .logo__coin {
    width: 58px;
    height: 58px;
  }

  .logo--large .logo__name {
    font-size: 2.2rem;
  }

  .logo--light,
  .logo--light .logo__coin {
    color: #fff;
  }

  .logo--light .logo__coin {
    color: var(--gold);
  }

  .logo--light .logo__kind {
    color: rgb(255 255 255 / 0.72);
  }
</style>
