---
// A drawn map. The address is made up, so there's no real map to show.
import { site } from '../site';
---

<figure class="map">
  <svg viewBox="0 0 600 340" role="img" aria-label={`Sketch map showing the shop at ${site.address.street}`}>
    <rect width="600" height="340" fill="#cfe6da"></rect>
    <g fill="#e3f0e9">
      <rect x="20" y="20" width="170" height="110"></rect>
      <rect x="220" y="20" width="160" height="110"></rect>
      <rect x="410" y="20" width="170" height="110"></rect>
      <rect x="20" y="170" width="170" height="150"></rect>
      <rect x="220" y="170" width="160" height="150"></rect>
      <rect x="410" y="170" width="170" height="150"></rect>
    </g>
    <rect x="0" y="130" width="600" height="40" fill="#f6f6f3"></rect>
    <rect x="190" y="0" width="30" height="340" fill="#f6f6f3"></rect>
    <rect x="380" y="0" width="30" height="340" fill="#f6f6f3"></rect>
    <text x="34" y="156" class="map__street">Brasswick St</text>
    <text x="198" y="300" class="map__street" transform="rotate(-90 198 300)">Vesper Ave</text>
    <!-- the shop -->
    <rect x="236" y="176" width="128" height="58" fill="#5c1c24"></rect>
    <g transform="translate(244 184)">
      <rect width="10" height="42" fill="#ffffff"></rect>
      <path d="M0 4 l10 -6 v6 l-10 6 z M0 16 l10 -6 v6 l-10 6 z M0 28 l10 -6 v6 l-10 6 z" fill="#b5262f"></path>
    </g>
    <text x="264" y="209" class="map__shop">Sixpenny</text>
    <text x="264" y="226" class="map__note">Door on Brasswick</text>
    <text x="236" y="262" class="map__park">Street parking, free after 6 pm</text>
  </svg>
</figure>

<style>
  .map {
    margin: 0;
    border: 1.5px solid var(--ink);
  }

  .map svg {
    width: 100%;
    height: auto;
  }

  .map__street {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    fill: #5d5755;
  }

  .map__shop {
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 700;
    fill: #d8b469;
  }

  .map__note {
    font-family: var(--sans);
    font-size: 12px;
    fill: #ffffff;
  }

  .map__park {
    font-family: var(--sans);
    font-size: 12px;
    fill: #5d5755;
  }
</style>
