---
// Stays at the bottom of the screen on phones.
// Colors come from --bar-* in global.css; the second button from site.cta.
import { site } from '../site';
---

<div class="call-bar">
  <a class="call-bar__call" href={site.phoneHref}>Call {site.phone}</a>
  <a class="call-bar__alt" href={site.cta.href}>{site.cta.label}</a>
</div>

<style>
  .call-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 20;
    display: none;
    grid-template-columns: 3fr 2fr;
    box-shadow: 0 -1px 0 var(--bar-edge, rgb(0 0 0 / 0.25));
  }

  .call-bar a {
    padding: 1.05rem 0.75rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  .call-bar__call {
    background: var(--bar-call-bg);
    color: var(--bar-call-ink);
  }

  .call-bar__alt {
    background: var(--bar-alt-bg);
    color: var(--bar-alt-ink);
  }

  @media (max-width: 47.99rem) {
    .call-bar {
      display: grid;
    }
  }
</style>
