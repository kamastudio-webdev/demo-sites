---
import '@fontsource-variable/bodoni-moda/standard.css';
import '@fontsource-variable/jost';
import '../styles/global.css';

import DemoBanner from '../components/DemoBanner.astro';
import Header from '../components/Header.astro';
import CallBand from '../components/CallBand.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import { site } from '../site';

interface Props {
  title: string;
  description: string;
  callBand?: boolean;
}
const { title, description, callBand = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Demo site: keep it out of search results. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#5c1c24" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Google Analytics: KamaStudio Demo Sites -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
    <script is:inline define:vars={{ gaId: site.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <DemoBanner />
    <Header />
    <main id="main">
      <slot />
    </main>
    {callBand && <CallBand />}
    <Footer />
    <CallBar />
  </body>
</html>
