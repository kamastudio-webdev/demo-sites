---
import Logo from './Logo.astro';
import { site } from '../site';
const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="site-foot__stripes" aria-hidden="true"></div>
  <div class="wrap site-foot__grid">
    <div>
      <Logo tone="light" />
      <p class="site-foot__blurb">Weekly mowing and year-round lawn care across {site.city} and the Triangle.</p>
    </div>

    <div>
      <h2>Call or text</h2>
      <p class="site-foot__phone"><a href={site.phoneHref}>{site.phone}</a></p>
      {site.hours.map((h) => <p>{h.days}: {h.time}</p>)}
    </div>

    <div>
      <h2>Where we mow</h2>
      <p>{site.areas.join(', ')}.</p>
    </div>

    <nav aria-label="Footer">
      <h2>Pages</h2>
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="wrap site-foot__legal">
    <p>
      © {year}{' '}{site.name}. A fictional business, made up to show what a {site.demo.studio} website looks like.
    </p>
    <p>
      Website design and development by{' '}<a href={site.demo.studioUrl}>{site.demo.studio}</a>
    </p>
  </div>
</footer>

<style>
  .site-foot {
    background: var(--deep);
    color: rgb(255 255 255 / 0.85);
    padding-bottom: 2rem;
    font-size: 0.95rem;
  }

  .site-foot__stripes {
    height: 18px;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
    background: repeating-linear-gradient(90deg, var(--grass) 0 60px, var(--grass-2) 60px 120px);
  }

  .site-foot a {
    color: #fff;
  }

  .site-foot__grid {
    display: grid;
    gap: 2.25rem;
  }

  @media (min-width: 40rem) {
    .site-foot__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 62rem) {
    .site-foot__grid {
      grid-template-columns: 1.4fr 1.2fr 1.2fr 0.8fr;
    }
  }

  .site-foot h2 {
    margin-bottom: 0.6rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--clipping);
  }

  .site-foot p {
    margin: 0;
  }

  .site-foot__blurb {
    margin-top: 1.1rem !important;
    max-width: 30ch;
  }

  .site-foot__phone {
    margin-bottom: 0.4rem !important;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.45rem;
  }

  .site-foot__phone a {
    text-decoration: none;
  }

  .site-foot li + li {
    margin-top: 0.3rem;
  }

  .site-foot__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 2.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.2);
    font-size: 0.86rem;
    color: rgb(255 255 255 / 0.7);
  }

  .site-foot__legal p {
    max-width: none;
  }
</style>
