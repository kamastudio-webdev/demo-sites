---
// Ballpark mowing price: pick a yard size and how often.
import { sizes, frequencies } from '../lawn';
import { site } from '../site';

interface Props {
  id?: string;
}
const { id = 'est' } = Astro.props;
const first = sizes[0];
const monthly = (perVisit: number, visits: number) => Math.round((perVisit * visits) / 5) * 5;
---

<div class="est" data-estimator data-sizes={JSON.stringify(sizes)} data-freqs={JSON.stringify(frequencies)}>
  <fieldset>
    <legend>How big is your yard?</legend>
    <div class="est__options est__options--sizes">
      {
        sizes.map((s, i) => (
          <label class="est__option">
            <input type="radio" name={`${id}-size`} value={s.id} checked={i === 0} />
            <span class="est__label">{s.label}</span>
            <span class="est__note">{s.note}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset>
    <legend>How often?</legend>
    <div class="est__options est__options--freq">
      {
        frequencies.map((f, i) => (
          <label class="est__option est__option--pill">
            <input type="radio" name={`${id}-freq`} value={f.id} checked={i === 0} />
            <span class="est__label">{f.label}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="est__result" aria-live="polite">
    <p class="est__price">
      <span class="est__amount" data-out="visit">${first.perVisit}</span>
      <span class="est__per">a visit</span>
    </p>
    <p class="est__month">
      About <strong data-out="month">${monthly(first.perVisit, frequencies[0].visitsPerMonth)}</strong> a month,
      March through November. Mowing, edging, trimming and blowing off the drive are all included.
    </p>
  </div>

  <a class="btn btn--primary est__cta" href={site.cta.href}>Get an exact price</a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-estimator]').forEach((root) => {
    const sizes = JSON.parse(root.dataset.sizes!);
    const freqs = JSON.parse(root.dataset.freqs!);
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;

    const update = () => {
      const s = sizes.find((x: any) => x.id === root.querySelector<HTMLInputElement>('input[name$="-size"]:checked')!.value);
      const f = freqs.find((x: any) => x.id === root.querySelector<HTMLInputElement>('input[name$="-freq"]:checked')!.value);
      const perVisit = s.perVisit + f.extra;
      out('visit').textContent = `$${perVisit}`;
      out('month').textContent = `$${Math.round((perVisit * f.visitsPerMonth) / 5) * 5}`;
    };
    root.querySelectorAll('input').forEach((i) => i.addEventListener('change', update));
  });
</script>

<style>
  .est {
    display: grid;
    gap: 1.4rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    box-shadow: 0 24px 50px -30px rgb(10 40 12 / 0.55);
  }

  .est fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .est legend {
    margin-bottom: 0.65rem;
    padding: 0;
    font-family: var(--display);
    font-weight: 700;
    font-stretch: 92%;
    font-size: 1.2rem;
  }

  .est__options {
    display: grid;
    gap: 0.5rem;
  }

  .est__options--freq {
    grid-template-columns: 1fr 1fr;
  }

  .est__option {
    position: relative;
    display: grid;
    gap: 0.1rem;
    padding: 0.75rem 1rem;
    border: 2px solid var(--line);
    border-radius: 14px;
    cursor: pointer;
  }

  .est__option--pill {
    border-radius: 999px;
    text-align: center;
  }

  .est__option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .est__option:has(input:checked) {
    border-color: var(--grass);
    background: #eef6e6;
  }

  .est__option:has(input:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .est__label {
    font-weight: 700;
  }

  .est__note {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .est__result {
    padding-top: 1.1rem;
    border-top: 2px dashed var(--line);
  }

  .est__price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
  }

  .est__amount {
    font-family: var(--display);
    font-weight: 800;
    font-stretch: 85%;
    font-size: clamp(3rem, 7vw, 4rem);
    line-height: 1;
    color: var(--grass);
  }

  .est__per {
    font-weight: 600;
    font-size: 1.1rem;
  }

  .est__month {
    margin: 0;
    font-size: 0.98rem;
  }

  .est__cta {
    justify-self: start;
  }
</style>
