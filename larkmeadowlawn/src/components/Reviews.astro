---
// Made-up reviews, labeled as samples.
const reviews = [
  {
    text: "Same crew, same day, every week since 2021. I've stopped thinking about the yard, which was the whole point.",
    who: 'Keisha D.',
    where: 'North Hills',
  },
  {
    text: 'They aerated and seeded our fescue in September. By Thanksgiving the bare spots under the oak were gone.',
    who: 'Brian and Sue T.',
    where: 'Cary',
  },
  {
    text: 'I get a text the night before and a photo when they finish. When I travel for work, that photo is worth a lot.',
    who: 'Andre M.',
    where: 'Wake Forest',
  },
];
const initials = (s: string) =>
  s
    .split(/\s+/)
    .filter((w) => /^[A-Z]/.test(w))
    .slice(0, 2)
    .map((w) => w[0])
    .join('');
---

<ul class="reviews">
  {
    reviews.map((r) => (
      <li>
        <p class="reviews__tag">Sample review</p>
        <blockquote>
          <p>{r.text}</p>
        </blockquote>
        <p class="reviews__who">
          <span class="reviews__face" aria-hidden="true">
            {initials(r.who)}
          </span>
          <span>
            <strong>{r.who}</strong>
            <br />
            {r.where}
          </span>
        </p>
      </li>
    ))
  }
</ul>

<style>
  .reviews {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 56rem) {
    .reviews {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .reviews li {
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    border-radius: var(--radius);
    background: var(--white);
  }

  .reviews__tag {
    margin: 0 0 0.75rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--grass);
  }

  .reviews blockquote {
    margin: 0 0 1.25rem;
    flex: 1;
  }

  .reviews blockquote p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .reviews__who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    line-height: 1.3;
  }

  .reviews__face {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--sky);
    color: var(--deep);
    font-weight: 800;
  }
</style>
