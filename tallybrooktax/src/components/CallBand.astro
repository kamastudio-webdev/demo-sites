---
import { site } from '../site';
---

<section class="band band--ink call-band">
  <div class="wrap call-band__row">
    <div>
      <h2>Got a letter from the IRS?</h2>
      <p>
        Don't sit on it. Call and read it to us. We'll tell you what it means, whether you owe
        anything, and what to send back. For our clients, that's free.
      </p>
    </div>
    <div class="btn-row">
      <a class="btn call-band__call" href={site.phoneHref}>Call {site.phone}</a>
      <a class="btn call-band__line" href={site.cta.href}>{site.cta.label}</a>
    </div>
  </div>
</section>

<style>
  .call-band__row {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  .call-band p {
    margin: 1rem 0 0;
    max-width: 54ch;
    color: rgb(255 255 255 / 0.85);
  }

  .call-band__call {
    background: #fff;
    color: var(--ink) !important;
  }

  .call-band__call:hover {
    background: var(--box);
  }

  .call-band__line {
    border-color: #fff;
    color: #fff;
  }

  .call-band__line:hover {
    background: rgb(255 255 255 / 0.12);
  }

  @media (min-width: 56rem) {
    .call-band__row {
      grid-template-columns: 1fr auto;
    }
  }
</style>
