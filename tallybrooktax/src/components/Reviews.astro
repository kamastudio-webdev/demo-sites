---
// Made-up reviews, labeled as samples. One large, two small.
const [lead, ...rest] = [
  {
    text: 'I showed up with a grocery bag of receipts from my cleaning business and left with a return I understood. Lena explained every line, and the price was what she quoted on the phone.',
    who: 'Tamika J., Hilliard',
  },
  {
    text: 'We got a letter saying we owed $2,300. Ray read it, called the IRS with us, and it turned out to be their mistake.',
    who: 'Greg and Ana L., Grandview',
  },
  {
    text: 'Same preparer every year, and she remembers my situation. I can drop my papers off on the way to work.',
    who: 'Phil M., Clintonville',
  },
];
---

<div class="reviews">
  <figure class="reviews__lead">
    <p class="reviews__tag">Sample review</p>
    <blockquote>
      <p>{lead.text}</p>
    </blockquote>
    <figcaption>{lead.who}</figcaption>
  </figure>
  <div class="reviews__rest">
    {
      rest.map((r) => (
        <figure>
          <p class="reviews__tag">Sample review</p>
          <blockquote>
            <p>{r.text}</p>
          </blockquote>
          <figcaption>{r.who}</figcaption>
        </figure>
      ))
    }
  </div>
</div>

<style>
  .reviews {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 56rem) {
    .reviews {
      grid-template-columns: 7fr 5fr;
      gap: 3.5rem;
    }
  }

  .reviews figure {
    margin: 0;
  }

  .reviews blockquote {
    margin: 0;
  }

  .reviews__tag {
    margin: 0 0 0.6rem;
    font-size: 0.86rem;
    color: var(--muted);
  }

  .reviews__lead blockquote p {
    font-family: var(--slab);
    font-weight: 600;
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    line-height: 1.3;
    max-width: 30ch;
  }

  .reviews__rest {
    display: grid;
    gap: 1.5rem;
  }

  .reviews__rest figure {
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .reviews__rest figure:first-child {
    padding-top: 0;
    border-top: 0;
  }

  @media (min-width: 56rem) {
    .reviews__rest {
      padding-left: 2.5rem;
      border-left: 1px solid var(--rule);
    }
  }

  .reviews__rest blockquote p {
    font-size: 1.05rem;
  }

  .reviews figcaption {
    font-weight: 600;
  }
</style>
