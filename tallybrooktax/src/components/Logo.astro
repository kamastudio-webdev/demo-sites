---
// The mark is a set of tally marks (four strokes and a slash) over a brook.
import { site } from '../site';

interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`]}>
  <svg class="logo__mark" viewBox="0 0 48 48" width="44" height="44" aria-hidden="true">
    <rect x="1.5" y="1.5" width="45" height="45" rx="5" fill="none" stroke="currentColor" stroke-width="3"
    ></rect>
    <g stroke="currentColor" stroke-width="3.2" stroke-linecap="round">
      <line x1="13" y1="10" x2="13" y2="30"></line>
      <line x1="19.5" y1="10" x2="19.5" y2="30"></line>
      <line x1="26" y1="10" x2="26" y2="30"></line>
      <line x1="32.5" y1="10" x2="32.5" y2="30"></line>
      <line class="logo__slash" x1="9" y1="27" x2="37" y2="12"></line>
    </g>
    <path
      class="logo__brook"
      d="M8 38 q4 -4 8 0 t8 0 t8 0 t8 0"
      fill="none"
      stroke-width="3"
      stroke-linecap="round"></path>
  </svg>
  <span class="logo__words">
    <span class="logo__name">{site.short}</span>
    <span class="logo__kind">{site.kind}</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    line-height: 1;
    color: var(--ink);
  }

  .logo__mark {
    flex: none;
    color: var(--ink);
  }

  .logo__slash {
    stroke: var(--stamp);
  }

  .logo__brook {
    stroke: var(--ledger);
  }

  .logo__words {
    display: grid;
    gap: 0.25rem;
  }

  .logo__name {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 1.55rem;
    letter-spacing: -0.01em;
  }

  .logo__kind {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
  }

  .logo--light,
  .logo--light .logo__mark {
    color: #fff;
  }

  .logo--light .logo__brook {
    stroke: #9db6e0;
  }

  .logo--light .logo__slash {
    stroke: #f08a80;
  }

  .logo--light .logo__kind {
    color: rgb(255 255 255 / 0.72);
  }
</style>
