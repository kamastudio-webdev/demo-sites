---
import Logo from './Logo.astro';
import { site } from '../site';
const year = new Date().getFullYear();
const { season, offSeason } = site.hours;
---

<footer class="site-foot">
  <div class="wrap site-foot__grid">
    <div>
      <Logo tone="light" />
      <p class="site-foot__blurb">
        Personal and small business tax returns in {site.city}, with the same preparer every year.
      </p>
    </div>

    <div>
      <h2>Office</h2>
      <p>
        {site.address.street}<br />
        {site.address.cityLine}<br />
        <a href={site.phoneHref}>{site.phone}</a>
      </p>
    </div>

    <div>
      <h2>Hours</h2>
      {
        [season, offSeason].map((block) => (
          <div class="site-foot__hours">
            <p class="site-foot__when">{block.label}</p>
            {block.rows.map((r) => (
              <p>
                {r.days}: {r.time}
              </p>
            ))}
          </div>
        ))
      }
    </div>

    <nav aria-label="Footer">
      <h2>Pages</h2>
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="wrap site-foot__legal">
    <p>
      © {year}{' '}{site.name}. A fictional business, made up to show what a {site.demo.studio} website looks like.
    </p>
    <p>
      Website design and development by{' '}<a href={site.demo.studioUrl}>{site.demo.studio}</a>
    </p>
  </div>
</footer>

<style>
  .site-foot {
    background: var(--ink);
    color: rgb(255 255 255 / 0.85);
    padding-block: clamp(2.75rem, 6vw, 4.25rem) 2rem;
    font-size: 0.95rem;
  }

  .site-foot a {
    color: #fff;
  }

  .site-foot__grid {
    display: grid;
    gap: 2.25rem;
  }

  @media (min-width: 40rem) {
    .site-foot__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 62rem) {
    .site-foot__grid {
      grid-template-columns: 1.5fr 1fr 1.4fr 0.8fr;
    }
  }

  .site-foot h2 {
    margin-bottom: 0.7rem;
    font-size: 1.05rem;
    color: #fff;
  }

  .site-foot p {
    margin: 0;
  }

  .site-foot__blurb {
    margin-top: 1.1rem !important;
    max-width: 32ch;
  }

  .site-foot__hours + .site-foot__hours {
    margin-top: 0.8rem;
  }

  .site-foot__when {
    font-weight: 600;
    color: #fff;
  }

  .site-foot li + li {
    margin-top: 0.3rem;
  }

  .site-foot__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 2.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.2);
    font-size: 0.86rem;
    color: rgb(255 255 255 / 0.7);
  }

  .site-foot__legal p {
    max-width: none;
  }
</style>
