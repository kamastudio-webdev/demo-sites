---
// How a return gets done, in order.
const steps = [
  {
    title: 'Book a time',
    text: 'Call or send a message. Sit down with your preparer, or drop your papers off and pick up later.',
  },
  {
    title: 'Bring your papers',
    text: "Use our checklist. If something's missing, we'll tell you before we start, not after.",
  },
  {
    title: 'Go over it together',
    text: 'Your preparer walks you through the return and answers your questions. You see the fee before you sign.',
  },
  {
    title: 'Sign, and we e-file',
    text: 'We file your federal, Ohio and city returns and email you a copy. You get a text when the IRS accepts it.',
  },
];
---

<ol class="steps">
  {
    steps.map((s, i) => (
      <li>
        <span class="steps__no" aria-hidden="true">
          {i + 1}
        </span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    gap: 1.75rem;
  }

  .steps li {
    position: relative;
    padding-left: 3.75rem;
  }

  .steps__no {
    position: absolute;
    left: 0;
    top: -0.15rem;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1.5px solid var(--ink);
    background: var(--white);
    font-family: var(--slab);
    font-weight: 700;
    font-size: 1.25rem;
  }

  .steps h3 {
    margin-bottom: 0.4rem;
  }

  .steps p {
    margin: 0;
  }

  @media (min-width: 56rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }

    .steps li {
      padding: 3.75rem 0 0;
    }

    /* A rule runs through the boxes, from first step to last. */
    .steps li::before {
      content: '';
      position: absolute;
      top: 1.15rem;
      left: 2.6rem;
      right: -2rem;
      border-top: 1.5px solid var(--ink);
    }

    .steps li:last-child::before {
      display: none;
    }

    .steps__no {
      top: 0;
    }
  }
</style>
