---
import Logo from './Logo.astro';
import { site } from '../site';

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-head">
  <div class="wrap site-head__row">
    <a class="site-head__logo" href="/" aria-label={`${site.name}, home`}>
      <Logo />
    </a>

    <div class="site-head__right">
      <a class="site-head__phone" href={site.phoneHref}>{site.phone}</a>
      <a class="btn btn--primary site-head__book" href={site.cta.href}>{site.cta.label}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    </div>
  </div>

  <nav id="site-nav" class="site-nav" aria-label="Main">
    <ul class="wrap">
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={here === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .site-head {
    background: var(--white);
    border-bottom: 1px solid var(--rule);
  }

  .site-head__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.95rem;
  }

  .site-head__logo {
    text-decoration: none;
  }

  .site-head__right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-head__phone {
    font-family: var(--slab);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink);
    text-decoration: none;
  }

  /* The menu sits on its own ruled line, like the first line of a form. */
  .site-nav {
    border-top: 1px solid var(--rule);
  }

  .site-nav ul {
    display: flex;
    gap: 2rem;
  }

  .site-nav a {
    display: block;
    padding-block: 0.7rem;
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
  }

  .site-nav a:hover {
    color: var(--ledger);
  }

  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--ledger);
    color: var(--ledger);
    font-weight: 600;
  }

  .menu-btn {
    display: none;
    padding: 0.55rem 0.95rem;
    border: 1.5px solid var(--ink);
    border-radius: 3px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  @media (max-width: 47.99rem) {
    .site-head__phone,
    .site-head__book {
      display: none;
    }

    .menu-btn {
      display: block;
    }

    .site-nav {
      display: none;
    }

    .site-nav.is-open {
      display: block;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0;
    }

    .site-nav li + li {
      border-top: 1px solid var(--rule);
    }

    .site-nav a {
      padding-block: 0.85rem;
      border-bottom: 0;
      margin: 0;
    }
  }
</style>
