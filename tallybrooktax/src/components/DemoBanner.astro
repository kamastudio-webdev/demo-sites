---
// The "this is a demo" banner across the top of every page.
// Colors come from --banner-bg and --banner-ink in global.css.
import { site } from '../site';
const d = site.demo;
---

<aside class="demo-banner" aria-label="About this demo">
  <p>
    <strong>Demo site by {d.studio}.</strong>{' '}
    {site.name} is a fictional business. Want a site like this? Call {d.contact} at{' '}
    <a href={d.phoneHref}>{d.phone}</a> or visit{' '}
    <a href={d.studioUrl}>{d.studioUrl.replace('https://', '')}</a>.
  </p>
</aside>

<style>
  .demo-banner {
    background: var(--banner-bg);
    color: var(--banner-ink);
    font-size: 0.86rem;
    line-height: 1.35;
  }

  .demo-banner p {
    width: min(100% - 2rem, 74rem);
    max-width: none;
    margin: 0 auto;
    padding-block: 0.55rem;
    text-align: center;
  }

  .demo-banner a {
    color: inherit;
    font-weight: 700;
    white-space: nowrap;
  }
</style>
